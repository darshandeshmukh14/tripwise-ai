# Copy to .env.local (never commit). Read by the Next.js server only (BFF route handlers / proxy).

# Spring Boot API base URL (no trailing slash).
BACKEND_URL=http://localhost:8080
# Upper bound for a proxied backend call; chat refinement can take up to ~60s.
# BACKEND_TIMEOUT_MS=75000
# Forward X-Forwarded-For to Spring only when Next.js runs behind a trusted reverse proxy.
# TRUST_PROXY_HEADERS=false
