# Copy to .env (never commit .env). Must equal Spring's ai-service.api-key (AI_SERVICE_API_KEY); dev default shown.
INTERNAL_API_TOKEN=tripwise-local-internal-token

# fake = deterministic offline planner (no key needed); gemini = Google Gemini; openrouter = any model on openrouter.ai
LLM_PROVIDER=fake
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# Any OpenRouter model id that supports structured outputs, e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4, google/gemini-2.5-flash
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=TripWise AI
# LLM_TIMEOUT_SECONDS=40
# PLAN_DEADLINE_SECONDS=50
# CITY_LOOKUP_TIMEOUT_SECONDS=10
# LLM_TEMPERATURE=0.6
# BUDGET_GUARD_MAX_LOOPS=2
# LOG_LEVEL=INFO

# FX: open_er_api = free daily rates from https://open.er-api.com (attribution shown in the UI); static = bundled table
# FX_PROVIDER=open_er_api
# FX_TIMEOUT_SECONDS=3
# FX_CACHE_TTL_SECONDS=86400

# Web price hints via Gemini Google Search grounding (billed separately; needs LLM_PROVIDER=gemini, ignored for openrouter)
# GROUNDING_ENABLED=false
# GROUNDING_DAILY_CAP=200
# WEB_HINTS_PER_PLAN=4
# PRICE_HINT_TIMEOUT_SECONDS=12
# PRICE_HINT_CACHE_TTL_SECONDS=86400
# Global daily cap on all Gemini calls (0 = unlimited); over the cap deterministic fallbacks are used
# LLM_DAILY_CAP=0

# Booking links. LINK_TEMPLATES: JSON {provider: url-template} overriding app/prices/links.py defaults.
# Affiliate IDs are appended only when set; links are unchanged otherwise.
# LINK_TEMPLATES=
# AFFILIATE_SKYSCANNER_ID=
# AFFILIATE_BOOKING_AID=
# AFFILIATE_AIRBNB_ID=
# AFFILIATE_REDBUS_ID=
# AFFILIATE_12GO_ID=
