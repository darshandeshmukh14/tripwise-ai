# Production settings for compose.prod.yml. Copy to .env (git-ignored), fill in, then: chmod 600 .env
# Generate secrets: JWT_SECRET -> openssl rand -base64 32 ; AI_SERVICE_API_KEY / DB_PASSWORD -> openssl rand -hex 24

# Public hostname pointing at this server (e.g. tripwise.duckdns.org); Caddy gets the HTTPS certificate for it
DOMAIN=

DB_PASSWORD=
# Base64 HMAC key, at least 32 bytes
JWT_SECRET=
# Shared Spring <-> ai-service token, at least 16 characters
AI_SERVICE_API_KEY=

# gemini (needs GEMINI_API_KEY), openrouter (needs OPENROUTER_API_KEY; any model) or fake (offline demo planner)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# Global daily cap on Gemini calls (0 = unlimited)
# LLM_DAILY_CAP=500
# Web price hints via Google Search grounding (billed separately)
# GROUNDING_ENABLED=false
# RATE_LIMIT_WEB_HINTS_CAPACITY=20
# Plans per client IP per day without an account (needs TRUST_PROXY_HEADERS=true on the frontend)
# RATE_LIMIT_GUEST_GENERATE_CAPACITY=5

# Heap is 60% of container memory by default; on a 1 GB VM use e.g. -Xmx384m
# BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=60
